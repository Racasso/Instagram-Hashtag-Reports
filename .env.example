# Skopiuj ten plik jako .env i wstaw lokalnie swój token z Apify Console.
# Nie wpisuj prawdziwego tokenu do tego pliku ani nie commituj .env.
APIFY_TOKEN=uzupelnij_lokalnie
APIFY_ACTOR_ID=instagram-data-api/instagram-tagged-scraper
MAX_APIFY_COST_USD=0.20
APIFY_PRICE_PER_1000_RESULTS_USD=0.37
APIFY_RUN_TIMEOUT_SECONDS=300
APIFY_WAIT_SECONDS=360
MONGODB_URI=mongodb://mongo:27017
MONGODB_DATABASE=instagram_reports
WORKER_POLL_SECONDS=2
LOG_LEVEL=INFO
